---
import { FAMILY, isExternal } from '../lib/sites'
---
<footer class="ft">
  <div class="container inner">
    <span class="mark">Val'Run · Chronicles</span>
    <nav class="fam" aria-label="Val'Run sites">
      {FAMILY.map((s, i) => (
        <Fragment>
          {i > 0 && <span class="ftsep" aria-hidden="true">·</span>}
          {s.current
            ? <span class="ftlink current" aria-current="page">{s.label}</span>
            : <a class="ftlink" href={s.url} rel={isExternal(s.url) ? 'noopener' : undefined}>{s.label}</a>}
        </Fragment>
      ))}
    </nav>
  </div>
</footer>
<style>
  .ft{border-top:1px solid var(--ink-line);padding:var(--space-8) 0;color:var(--vellum-mute);font-family:var(--smcap);letter-spacing:.06em;font-size:.85rem}
  .inner{display:flex;justify-content:space-between;align-items:center;gap:var(--space-6);flex-wrap:wrap}
  .mark{letter-spacing:.06em}
  .fam{display:flex;align-items:center;gap:var(--space-4)}
  .ftlink{font-family:var(--smcap);letter-spacing:.15em;font-size:.75rem;color:var(--vellum-mute);border:none}
  .ftlink:hover{color:var(--gold);border:none}
  .ftlink.current{color:var(--gold)}
  .ftsep{color:var(--vellum-mute);opacity:.55}
</style>
